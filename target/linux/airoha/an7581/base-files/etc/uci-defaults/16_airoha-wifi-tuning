#!/bin/sh

. /lib/functions.sh
. /lib/functions/system.sh

# The wifi-iface sections are generated by netifd from board.json.  On a fresh
# install this default script can run before that has happened, so make sure
# the configuration exists before tuning it.
uci -q get wireless.default_radio0 >/dev/null 2>&1 || /sbin/wifi config 2>/dev/null

config_load wireless

changed=0

tune_wifi_iface() {
	local cfg="$1"
	local mode

	config_get mode "$cfg" mode
	[ "$mode" = "ap" ] || return 0

	# U-APSD lets a power-save client stagger its uplink into trigger bursts.
	# On the MT7996 plus Airoha NPU platform the 160 MHz downlink then stalls
	# at a low rate with a large tx_failed count until the client reassociates,
	# so do not advertise it.
	if [ "$(uci -q get wireless."$cfg".uapsd)" != "0" ]; then
		uci set wireless."$cfg".uapsd='0'
		changed=1
	fi

	# Keep high-MCS clients associated when their ACK rate drops briefly.
	if [ "$(uci -q get wireless."$cfg".disassoc_low_ack)" != "0" ]; then
		uci set wireless."$cfg".disassoc_low_ack='0'
		changed=1
	fi
}

config_foreach tune_wifi_iface wifi-iface

[ "$changed" -eq 1 ] && uci commit wireless

exit 0
