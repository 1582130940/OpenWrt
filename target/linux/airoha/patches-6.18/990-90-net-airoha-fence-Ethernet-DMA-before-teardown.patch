+static int airoha_ppe_retry_quarantined_npu(struct airoha_ppe *ppe)
+{
+	struct airoha_npu *npu = ppe->quarantine_npu;
+	int err;
+
+	if (!npu)
+		return 0;
+
+	err = airoha_ppe_npu_quiesce(ppe->eth, npu);
+	if (err)
+		return err;
+
+	ppe->quarantine_npu = NULL;
+	WRITE_ONCE(ppe->dma_quiesced, true);
+	airoha_npu_put(npu);
+
+	return 0;
+}
+
+static int airoha_ppe_wait_hw_stopped(struct airoha_eth *eth)
+{
+	u32 val;
+	int err, i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		err = read_poll_timeout(airoha_fe_rr, val,
+					!(val & (PPE_GLO_CFG_EN_MASK |
+						 PPE_GLO_CFG_BUSY_MASK)), 10,
+					100 * USEC_PER_MSEC, false, eth,
+					REG_PPE_GLO_CFG(i));
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+static int airoha_ppe_npu_quiesce(struct airoha_eth *eth,
+				  struct airoha_npu *npu)
+{
+	int err;
+
+	err = airoha_ppe_npu_deinit_retry(npu);
+	return err ? err : airoha_ppe_wait_hw_stopped(eth);
+}
+
+static int airoha_ppe_terminal_fence(struct airoha_eth *eth,
+				     struct airoha_npu *npu)
+{
+	int err, i, status;
+
+	err = airoha_npu_hard_stop(npu);
+	if (err)
+		return err;
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(i), PPE_GLO_CFG_EN_MASK);
+
+	err = airoha_ppe_wait_hw_stopped(eth);
+	if (!err)
+		return 0;
+
+	err = reset_control_assert(eth->rsts[0].rstc);
+	if (err)
+		return err;
+
+	status = reset_control_status(eth->rsts[0].rstc);
+	if (status < 0)
+		return status;
+
+	return status ? 0 : -EIO;
+}
