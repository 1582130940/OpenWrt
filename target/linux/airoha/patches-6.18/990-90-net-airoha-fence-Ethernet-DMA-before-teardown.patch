+static int airoha_ppe_npu_deinit_retry(struct airoha_npu *npu)
+{
+	int err;
+
+	err = npu->ops.ppe_deinit(npu);
+	if (err == -EAGAIN) {
+		err = airoha_npu_wait_recovery(npu);
+		if (err && err != -ETIMEDOUT)
+			return err;
+
+		if (!err)
+			err = npu->ops.ppe_deinit(npu);
+	}
+
+	if (err != -ETIMEDOUT)
+		return err;
+
+	err = airoha_npu_recover_mailbox(npu);
+	if (err)
+		return err;
+
+	return npu->ops.ppe_deinit(npu);
+}
