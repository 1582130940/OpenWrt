From: longnt2007 <longnt2007@gmail.com>
Subject: [PATCH] net: airoha: Reduce RX Descriptor READ_ONCE Overhead

Reduce repeated RX descriptor loads in the QDMA RX path by reading the
producer-owned fields once after DONE is observed and dma_rmb() has
ordered the descriptor contents.

Pass the decoded msg1/msg2 values through the RX skb builders and source
port lookup callbacks so the hot path does not reload the same descriptor
words. Keep the combined msg1/msg2 load limited to 64-bit builds with
efficient unaligned access because the common Airoha patch stack also
covers the 32-bit EN7523 subtarget.

Keep the RX queue structure cacheline aligned to match the downstream
performance change and avoid sharing hot queue state with adjacent
allocations.

Signed-off-by: longnt2007 <longnt2007@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 57 ++++++++++++++++++++------------
 drivers/net/ethernet/airoha/airoha_eth.h |  5 ++-
 2 files changed, 38 insertions(+), 24 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -895,12 +895,12 @@ static int airoha_qdma_fill_rx_queue(struct airoha_queue *q)
 }
 
 static struct airoha_gdm_dev *
-airoha_qdma_get_gdm_dev(struct airoha_eth *eth, struct airoha_qdma_desc *desc)
+airoha_qdma_get_gdm_dev(struct airoha_eth *eth, u32 msg1)
 {
 	struct airoha_gdm_port *port;
 	u16 p, d;
 
-	if (eth->soc->ops.get_dev_from_sport(desc, &p, &d))
+	if (eth->soc->ops.get_dev_from_sport(msg1, &p, &d))
 		return ERR_PTR(-ENODEV);
 
 	if (p >= ARRAY_SIZE(eth->ports))
@@ -918,10 +918,10 @@ airoha_qdma_get_gdm_dev(struct airoha_eth *eth, struct airoha_qdma_desc *desc)
 
 static int airoha_qdma_lro_rx_skb(struct airoha_queue *q,
 				  struct airoha_qdma_desc *desc,
-				  u32 msg1, u32 len)
+				  u32 msg1, u32 msg2, u32 len)
 {
 	u32 th_off, tcp_ack_seq, data_off, agg_count = 1;
-	u32 msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
+	u32 msg3;
 	struct skb_shared_info *shinfo;
 	struct sk_buff *skb = q->skb;
 	u16 tcp_win, l2_len;
@@ -994,8 +994,8 @@ static int airoha_qdma_lro_rx_skb(struct airoha_queue *q,
 	if (len <= data_off)
 		return -EINVAL;
 
-	tcp_win = FIELD_GET(QDMA_ETH_RXMSG_TCP_WIN_MASK,
-			    le32_to_cpu(READ_ONCE(desc->msg3)));
+	msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
+	tcp_win = FIELD_GET(QDMA_ETH_RXMSG_TCP_WIN_MASK, msg3);
 	tcp_ack_seq = le32_to_cpu(READ_ONCE(desc->data));
 	th->ack_seq = cpu_to_be32(tcp_ack_seq);
 	th->window = cpu_to_be16(tcp_win);
@@ -1051,6 +1051,24 @@ static int airoha_qdma_lro_rx_skb(struct airoha_queue *q,
 	return 0;
 }
 
+static inline void airoha_qdma_read_msg12(const struct airoha_qdma_desc *desc,
+						  u32 *msg1, u32 *msg2,
+						  bool read_msg2)
+{
+#if defined(CONFIG_64BIT) && defined(CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS)
+	u64 msg12;
+
+	msg12 = le64_to_cpu(READ_ONCE(*(const __le64 *)&desc->msg1));
+	*msg1 = (u32)msg12;
+	if (read_msg2)
+		*msg2 = (u32)(msg12 >> 32);
+#else
+	*msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+	if (read_msg2)
+		*msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
+#endif
+}
+
 #if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
 static bool airoha_qdma_rx_is_soe(u32 msg0)
 {
@@ -1081,7 +1099,7 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 	while (q->queued > 0 && done < budget && desc_done < desc_budget) {
 		struct airoha_queue_entry *e = &q->entry[q->tail];
 		struct airoha_qdma_desc *desc = &q->desc[q->tail];
-		u32 hash, reason, msg0, msg1, msg2, desc_ctrl;
+		u32 hash, reason, msg0, msg1, msg2 = 0, desc_ctrl;
 		struct airoha_gdm_dev *dev = NULL;
 		struct net_device *rx_dev = NULL;
 		struct net_device *netdev = NULL;
@@ -1090,6 +1108,7 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		bool partial_soe = q->skb && !q->skb->dev;
 #endif
 		bool soe_pkt = false;
+		bool first_frag;
 		int data_len, len;
 		struct page *page = NULL;
 
@@ -1099,6 +1118,9 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 
 		dma_rmb();
 		desc_done++;
+		first_frag = !q->skb;
+		msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
+		airoha_qdma_read_msg12(desc, &msg1, &msg2, first_frag);
 
 		q->tail = (q->tail + 1) % q->ndesc;
 		q->queued--;
@@ -1129,14 +1151,11 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		if (!len || data_len < len)
 			goto free_frag;
 
-		msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
-		msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
-		msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
 #if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
 		soe_pkt = partial_soe || airoha_qdma_rx_is_soe(msg0);
 #endif
 		if (!soe_pkt) {
-			dev = airoha_qdma_get_gdm_dev(eth, desc);
+			dev = airoha_qdma_get_gdm_dev(eth, msg1);
 			if (IS_ERR(dev))
 				goto free_frag;
 
@@ -1144,7 +1163,7 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 			rx_dev = netdev;
 		}
 
-		if (!q->skb) { /* first buffer */
+		if (first_frag) { /* first buffer */
 			if (soe_pkt) {
 				if (q->rx_coherent) {
 					q->skb = napi_alloc_skb(&q->napi, len);
@@ -1181,7 +1200,7 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 				q->skb->ip_summed = CHECKSUM_UNNECESSARY;
 				skb_record_rx_queue(q->skb, qid);
 
-				if (airoha_qdma_lro_rx_skb(q, desc, msg1, len)) {
+				if (airoha_qdma_lro_rx_skb(q, desc, msg1, msg2, len)) {
 					dev_core_stats_rx_dropped_inc(netdev);
 					dev_kfree_skb(q->skb);
 					q->skb = NULL;
@@ -5050,11 +5069,9 @@ static u32 airoha_en7581_get_vip_port(struct airoha_gdm_port *port, int nbq)
 	return 0;
 }
 
-static int airoha_en7581_get_dev_from_sport(struct airoha_qdma_desc *desc,
-					    u16 *port, u16 *dev)
+static int airoha_en7581_get_dev_from_sport(u32 msg1, u16 *port, u16 *dev)
 {
-	u32 sport = FIELD_GET(QDMA_ETH_RXMSG_SPORT_MASK,
-			      le32_to_cpu(READ_ONCE(desc->msg1)));
+	u32 sport = FIELD_GET(QDMA_ETH_RXMSG_SPORT_MASK, msg1);
 
 	*dev = 0;
 	switch (sport) {
@@ -5133,11 +5150,9 @@ static u32 airoha_an7583_get_vip_port(struct airoha_gdm_port *port, int nbq)
 	return 0;
 }
 
-static int airoha_an7583_get_dev_from_sport(struct airoha_qdma_desc *desc,
-					    u16 *port, u16 *dev)
+static int airoha_an7583_get_dev_from_sport(u32 msg1, u16 *port, u16 *dev)
 {
-	u32 sport = FIELD_GET(QDMA_ETH_RXMSG_SPORT_MASK,
-			      le32_to_cpu(READ_ONCE(desc->msg1)));
+	u32 sport = FIELD_GET(QDMA_ETH_RXMSG_SPORT_MASK, msg1);
 
 	*dev = 0;
 	switch (sport) {
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -259,7 +259,7 @@ struct airoha_queue {
 
 	struct list_head tx_list;
 	union airoha_qdma_count count;
-};
+} ____cacheline_aligned;
 
 struct airoha_tx_irq_queue {
 	struct airoha_qdma *qdma;
@@ -730,8 +730,7 @@ struct airoha_eth_soc_data {
 	struct {
 		int (*get_sport)(struct airoha_gdm_port *port, int nbq);
 		u32 (*get_vip_port)(struct airoha_gdm_port *port, int nbq);
-		int (*get_dev_from_sport)(struct airoha_qdma_desc *desc,
-					  u16 *port, u16 *dev);
+		int (*get_dev_from_sport)(u32 msg1, u16 *port, u16 *dev);
 	} ops;
 };
 
