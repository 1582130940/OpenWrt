From: dsanke <dsanke1997@gmail.com>
Date: Sat, 23 Aug 2026 01:10:00 +0800
Subject: [PATCH] net: airoha: track direct bridge fallback lifetime

The PPE bridge-FDB fallback can bind an unbound FOE hash before the
netfilter flowtable installs an L2 master flow.  Its direct form did not
allocate a software subflow object, so nothing invalidated that hash when
the selected WLAN/GDM egress device went down, was unregistered, or the
destination MAC roamed to another bridge port.  SSID/AP-interface reloads
could therefore leave hardware entries pointing at a stale BSS/WCID path.

Allocate a tracked subflow for direct binds, store the actual committed
hardware entry (not merely the bridge template), and keep references to the
resolved egress netdev and destination MAC.  Remove matching entries from
netdev GOING_DOWN/DOWN/UNREGISTER events and bridge FDB delete events, then
clean all direct entries during PPE exit.

Signed-off-by: dsanke <dsanke1997@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.h |   5 +
 drivers/net/ethernet/airoha/airoha_ppe.c | 229 +++++++++++++++++++++++++++++--
 2 files changed, 221 insertions(+), 13 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -544,6 +544,8 @@ struct airoha_flow_table_entry {
 	};
 
 	struct hlist_node l2_subflow_node; /* PPE L2 subflow entry */
+	struct net_device *direct_dev; /* direct fallback egress owner */
+	u8 direct_addr[ETH_ALEN]; /* destination MAC owned by direct fallback */
 	u32 hash;
 
 	struct airoha_foe_stats64 stats;
@@ -656,6 +658,9 @@ struct airoha_ppe {
 	struct hlist_head *foe_flow;
 	u16 *foe_check_time;
 
+	struct notifier_block netdev_notifier;
+	struct notifier_block switchdev_notifier;
+
 	struct airoha_foe_stats *foe_stats;
 	dma_addr_t foe_stats_dma;
 
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -15,6 +15,7 @@
 #include <net/ipv6.h>
 #include <net/pkt_cls.h>
 #include <net/route.h>
+#include <net/switchdev.h>
 
 #include "airoha_regs.h"
 #include "airoha_eth.h"
@@ -813,7 +814,14 @@ static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
 {
 	lockdep_assert_held(&ppe_lock);
 
-	hlist_del_init(&e->list);
+	if (e->type == FLOW_TYPE_L2_SUBFLOW) {
+		if (e->direct_dev)
+			hlist_del_init(&e->list);
+		else
+			hlist_del_init(&e->l2_subflow_node);
+	} else {
+		hlist_del_init(&e->list);
+	}
 	if (e->hash != 0xffff) {
 		e->data.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
 		e->data.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
@@ -822,7 +830,10 @@ static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
 		e->hash = 0xffff;
 	}
 	if (e->type == FLOW_TYPE_L2_SUBFLOW) {
-		hlist_del_init(&e->l2_subflow_node);
+		if (e->direct_dev) {
+			dev_put(e->direct_dev);
+			e->direct_dev = NULL;
+		}
 		kfree(e);
 	}
 }
@@ -857,11 +868,12 @@ static void airoha_ppe_foe_flow_remove_entry(struct airoha_ppe *ppe,
 static int
 airoha_ppe_foe_commit_subflow(struct airoha_ppe *ppe,
 			      const struct airoha_foe_entry *bridge,
-			      u32 hash, bool rx_wlan)
+			      u32 hash, bool rx_wlan,
+			      struct airoha_foe_entry *bound)
 {
 	u32 mask = AIROHA_FOE_IB1_BIND_PACKET_TYPE | AIROHA_FOE_IB1_BIND_UDP;
 	struct airoha_foe_entry *hwe_p, hwe;
-	int type;
+	int err, type;
 
 	hwe_p = airoha_ppe_foe_get_entry_locked(ppe, hash);
 	if (!hwe_p)
@@ -890,7 +902,11 @@ airoha_ppe_foe_commit_subflow(struct airoha_ppe *ppe,
 	}
 
 	hwe.bridge.data = bridge->bridge.data;
-	return airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
+	err = airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
+	if (!err && bound)
+		memcpy(bound, &hwe, sizeof(*bound));
+
+	return err;
 }
 
 static int
@@ -905,7 +921,8 @@ airoha_ppe_foe_commit_subflow_entry(struct airoha_ppe *ppe,
 	if (!f)
 		return -ENOMEM;
 
-	err = airoha_ppe_foe_commit_subflow(ppe, &e->data, hash, rx_wlan);
+	err = airoha_ppe_foe_commit_subflow(ppe, &e->data, hash, rx_wlan,
+					      &f->data);
 	if (err) {
 		kfree(f);
 		return err;
@@ -918,6 +935,40 @@ airoha_ppe_foe_commit_subflow_entry(struct airoha_ppe *ppe,
 	return 0;
 }
 
+static int
+airoha_ppe_foe_commit_direct_subflow(struct airoha_ppe *ppe,
+				     const struct airoha_foe_entry *bridge,
+				     struct net_device *egress,
+				     const u8 *dest_addr,
+				     u32 hash, u32 index, bool rx_wlan)
+{
+	struct airoha_flow_table_entry *f;
+	int err;
+
+	f = kzalloc(sizeof(*f), GFP_ATOMIC);
+	if (!f) {
+		dev_put(egress);
+		return -ENOMEM;
+	}
+
+	f->direct_dev = egress;
+	ether_addr_copy(f->direct_addr, dest_addr);
+	err = airoha_ppe_foe_commit_subflow(ppe, bridge, hash, rx_wlan,
+					      &f->data);
+	if (err) {
+		f->direct_dev = NULL;
+		dev_put(egress);
+		kfree(f);
+		return err;
+	}
+
+	f->type = FLOW_TYPE_L2_SUBFLOW;
+	f->hash = hash;
+	hlist_add_head(&f->list, &ppe->foe_flow[index]);
+
+	return 0;
+}
+
 static bool
 airoha_ppe_foe_prepare_bridge_subflow_dev(struct airoha_ppe *ppe,
 					  struct net_device *dev,
@@ -981,7 +1032,9 @@ airoha_ppe_foe_get_bridge_master(struct net_device *dev)
 static bool
 airoha_ppe_foe_prepare_bridge_subflow(struct airoha_ppe *ppe,
 				      struct sk_buff *skb,
-				      struct airoha_foe_entry *hwe)
+				      struct airoha_foe_entry *hwe,
+				      struct net_device **direct_dev,
+				      u8 *direct_addr)
 {
 	struct net_device_path_stack stack;
 	struct net_device_path_ctx ctx = {};
@@ -992,12 +1045,15 @@ airoha_ppe_foe_prepare_bridge_subflow(struct airoha_ppe *ppe,
 	u16 vid, proto;
 	int err, i;
 
+	*direct_dev = NULL;
+
 	if (!is_valid_ether_addr(eh->h_source) ||
 	    !is_valid_ether_addr(eh->h_dest))
 		return false;
 
 	ether_addr_copy(data.eth.h_dest, eh->h_dest);
 	ether_addr_copy(data.eth.h_source, eh->h_source);
+	ether_addr_copy(direct_addr, eh->h_dest);
 
 	if (!skb->dev)
 		return false;
@@ -1098,9 +1154,13 @@ airoha_ppe_foe_prepare_bridge_subflow(struct airoha_ppe *ppe,
 	dev_put(master);
 	err = airoha_ppe_foe_prepare_bridge_subflow_dev(ppe, egress, &data,
 							hwe);
-	dev_put(egress);
+	if (!err) {
+		dev_put(egress);
+		return false;
+	}
 
-	return err;
+	*direct_dev = egress;
+	return true;
 }
 
 static bool airoha_ppe_flow_keys(struct sk_buff *skb,
@@ -1197,13 +1257,17 @@ static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
 	struct airoha_flow_table_entry *e;
 	struct airoha_foe_bridge br = {};
 	struct airoha_foe_entry *hwe;
+	struct net_device *bridge_dev = NULL;
+	u8 bridge_addr[ETH_ALEN] = {};
 	bool commit_done = false;
 	bool bridge_ready = false;
 	struct hlist_node *n;
 	u32 index, state;
 
 	bridge_ready = airoha_ppe_foe_prepare_bridge_subflow(ppe, skb,
-							     &bridge_hwe);
+							     &bridge_hwe,
+							     &bridge_dev,
+							     bridge_addr);
 
 	spin_lock_bh(&ppe_lock);
 
@@ -1251,12 +1315,22 @@ static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
 				   airoha_l2_flow_table_params);
-	if (e)
+	if (e) {
 		airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, rx_wlan);
-	else if (bridge_ready)
-		airoha_ppe_foe_commit_subflow(ppe, &bridge_hwe, hash, rx_wlan);
+		if (bridge_dev) {
+			dev_put(bridge_dev);
+			bridge_dev = NULL;
+		}
+	} else if (bridge_ready && bridge_dev) {
+		airoha_ppe_foe_commit_direct_subflow(ppe, &bridge_hwe,
+							 bridge_dev, bridge_addr,
+							 hash, index, rx_wlan);
+		bridge_dev = NULL;
+	}
 unlock:
 	spin_unlock_bh(&ppe_lock);
+	if (bridge_dev)
+		dev_put(bridge_dev);
 }
 
 static int
@@ -1908,6 +1982,117 @@ void airoha_ppe_put_dev(struct airoha_ppe_dev *dev)
 }
 EXPORT_SYMBOL_GPL(airoha_ppe_put_dev);
 
+static void airoha_ppe_remove_direct_flows_dev(struct airoha_ppe *ppe,
+					       struct net_device *dev)
+{
+	int num_entries = airoha_ppe_get_total_num_entries(ppe);
+	struct airoha_flow_table_entry *e;
+	struct hlist_node *n;
+	int i;
+
+	spin_lock_bh(&ppe_lock);
+
+	for (i = 0; i < num_entries; i++) {
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[i], list) {
+			if (e->type != FLOW_TYPE_L2_SUBFLOW || !e->direct_dev ||
+			    e->direct_dev != dev)
+				continue;
+
+			airoha_ppe_foe_remove_flow(ppe, e);
+		}
+	}
+
+	spin_unlock_bh(&ppe_lock);
+}
+
+static void
+airoha_ppe_remove_direct_flows_fdb(struct airoha_ppe *ppe,
+				   struct net_device *dev, const u8 *addr)
+{
+	int num_entries = airoha_ppe_get_total_num_entries(ppe);
+	struct airoha_flow_table_entry *e;
+	struct hlist_node *n;
+	int i;
+
+	spin_lock_bh(&ppe_lock);
+
+	for (i = 0; i < num_entries; i++) {
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[i], list) {
+			if (e->type != FLOW_TYPE_L2_SUBFLOW || !e->direct_dev ||
+			    e->direct_dev != dev ||
+			    !ether_addr_equal(e->direct_addr, addr))
+				continue;
+
+			airoha_ppe_foe_remove_flow(ppe, e);
+		}
+	}
+
+	spin_unlock_bh(&ppe_lock);
+}
+
+static void airoha_ppe_remove_direct_flows(struct airoha_ppe *ppe)
+{
+	int num_entries = airoha_ppe_get_total_num_entries(ppe);
+	struct airoha_flow_table_entry *e;
+	struct hlist_node *n;
+	int i;
+
+	spin_lock_bh(&ppe_lock);
+
+	for (i = 0; i < num_entries; i++) {
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[i], list) {
+			if (e->type == FLOW_TYPE_L2_SUBFLOW && e->direct_dev)
+				airoha_ppe_foe_remove_flow(ppe, e);
+		}
+	}
+
+	spin_unlock_bh(&ppe_lock);
+}
+
+static int airoha_ppe_netdev_event(struct notifier_block *nb,
+				   unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe,
+					      netdev_notifier);
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+
+	switch (event) {
+	case NETDEV_GOING_DOWN:
+	case NETDEV_DOWN:
+	case NETDEV_UNREGISTER:
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	airoha_ppe_remove_direct_flows_dev(ppe, dev);
+
+	return NOTIFY_DONE;
+}
+
+static int airoha_ppe_switchdev_event(struct notifier_block *nb,
+				       unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe,
+					      switchdev_notifier);
+	struct switchdev_notifier_info *info = ptr;
+	struct switchdev_notifier_fdb_info *fdb_info;
+	struct net_device *dev;
+
+	if (event != SWITCHDEV_FDB_DEL_TO_DEVICE || !info || !info->dev)
+		return NOTIFY_DONE;
+
+	dev = info->dev;
+	fdb_info = container_of(info, struct switchdev_notifier_fdb_info, info);
+	if (!fdb_info->addr || is_multicast_ether_addr(fdb_info->addr) ||
+	    fdb_info->is_local)
+		return NOTIFY_DONE;
+
+	airoha_ppe_remove_direct_flows_fdb(ppe, dev, fdb_info->addr);
+
+	return NOTIFY_DONE;
+}
+
 int airoha_ppe_init(struct airoha_eth *eth)
 {
 	int foe_size, err, ppe_num_stats_entries;
@@ -1969,8 +2154,22 @@ int airoha_ppe_init(struct airoha_eth *eth)
 	if (err)
 		goto error_l2_flow_table_destroy;
 
+	ppe->netdev_notifier.notifier_call = airoha_ppe_netdev_event;
+	err = register_netdevice_notifier(&ppe->netdev_notifier);
+	if (err)
+		goto error_debugfs_remove;
+
+	ppe->switchdev_notifier.notifier_call = airoha_ppe_switchdev_event;
+	err = register_switchdev_notifier(&ppe->switchdev_notifier);
+	if (err)
+		goto error_netdev_notifier;
+
 	return 0;
 
+error_netdev_notifier:
+	unregister_netdevice_notifier(&ppe->netdev_notifier);
+error_debugfs_remove:
+	debugfs_remove(ppe->debugfs_dir);
 error_l2_flow_table_destroy:
 	rhashtable_destroy(&ppe->l2_flows);
 error_flow_table_destroy:
@@ -1983,6 +2182,10 @@ void airoha_ppe_deinit(struct airoha_eth *eth)
 {
 	struct airoha_npu *npu;
 
+	unregister_switchdev_notifier(&eth->ppe->switchdev_notifier);
+	unregister_netdevice_notifier(&eth->ppe->netdev_notifier);
+	airoha_ppe_remove_direct_flows(eth->ppe);
+
 	mutex_lock(&flow_offload_mutex);
 
 	npu = rcu_replace_pointer(eth->npu, NULL,
