+static bool airoha_npu_mbox_done(const u8 *buf, u32 status, int len,
+				 u16 reply_len, bool health_check)
+{
+	u32 version;
+
+	if (!(status & MBOX_MSG_DONE))
+		return false;
+
+	dma_rmb();
+	if (!health_check)
+		return true;
+
+	/* A stale completion must not validate a post-reset mailbox epoch. */
+	memcpy(&version, buf + len - reply_len, sizeof(version));
+	return version && version != NPU_MBOX_HEALTH_SENTINEL;
+}
+
+static void airoha_npu_mbox_poison(struct airoha_npu_core *core)
+{
+	int slot;
+
+	__set_bit(core->mbox_slot, &core->mbox_poisoned);
+	core->mbox_blocked = true;
+
+	for (slot = core->mbox_slot + 1; slot < NPU_MBOX_NUM_SLOTS; slot++) {
+		if (!test_bit(slot, &core->mbox_poisoned)) {
+			core->mbox_slot = slot;
+			return;
+		}
+	}
+
+	core->mbox_slot = NPU_MBOX_NUM_SLOTS;
+}
