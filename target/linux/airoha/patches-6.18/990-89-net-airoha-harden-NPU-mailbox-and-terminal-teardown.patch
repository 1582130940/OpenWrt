+static int airoha_npu_mbox_health_check(struct airoha_npu *npu)
+{
+	struct wlan_mbox_data *wlan_data;
+	u32 version = NPU_MBOX_HEALTH_SENTINEL;
+	int len, err;
+
+	len = sizeof(*wlan_data) + sizeof(version);
+	wlan_data = kzalloc(len, GFP_KERNEL);
+	if (!wlan_data)
+		return -ENOMEM;
+
+	wlan_data->func_type = NPU_OP_GET;
+	wlan_data->func_id = WLAN_FUNC_GET_WAIT_NPU_VERSION;
+	memcpy(wlan_data->d, &version, sizeof(version));
+
+	err = __airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len,
+				    &version, sizeof(version), true);
+	kfree(wlan_data);
+	if (err)
+		return err;
+
+	return version && version != NPU_MBOX_HEALTH_SENTINEL ? 0 : -EIO;
+}
