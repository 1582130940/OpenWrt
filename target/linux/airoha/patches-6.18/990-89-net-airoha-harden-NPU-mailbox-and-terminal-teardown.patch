+int airoha_npu_hard_stop(struct airoha_npu *npu)
+{
+	unsigned long flags;
+	int i, err, status;
+
+	might_sleep();
+	mutex_lock(&npu->recovery_lock);
+	if (atomic_read_acquire(&npu->stopped)) {
+		status = reset_control_status(npu->rst);
+		if (status > 0) {
+			atomic_set_release(&npu->hard_stopped, 1);
+			err = 0;
+			goto unlock;
+		}
+	}
+
+	atomic_set_release(&npu->stopped, 1);
+	atomic_set_release(&npu->recovering, 1);
+	synchronize_rcu();
+	if (READ_ONCE(npu->provider_irqs_live)) {
+		devm_free_irq(npu->dev, npu->mbox_irq, npu);
+		for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+			struct airoha_npu_core *core = &npu->cores[i];
+
+			devm_free_irq(npu->dev, core->wdt_irq, core);
+		}
+		WRITE_ONCE(npu->provider_irqs_live, false);
+	}
+	spin_lock_irqsave(&npu->io_lock, flags);
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++)
+		regmap_set_bits(npu->regmap, REG_WDT_TIMER_CTRL(i),
+				WDT_INTR_MASK);
+	for (i = 0; i < 2; i++)
+		regmap_clear_bits(npu->regmap, REG_IRQ_RXDONE(i),
+				  NPU_IRQ_RX_MASK(i));
+	regmap_write(npu->regmap, REG_IRQ_STATUS,
+		     NPU_IRQ_RX_MASK(0) | NPU_IRQ_RX_MASK(1));
+	regmap_write(npu->regmap, REG_CR_MBOX_INT_STATUS,
+		     MBOX_INT_STATUS_MASK);
+	regmap_update_bits(npu->regmap, REG_CR_MBQ8_CTRL(3),
+			   MBOX_MSG_STATUS | MBOX_MSG_DONE, MBOX_MSG_DONE);
+	spin_unlock_irqrestore(&npu->io_lock, flags);
+
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		spin_lock_bh(&npu->cores[i].lock);
+		npu->cores[i].mbox_blocked = true;
+		spin_unlock_bh(&npu->cores[i].lock);
+	}
+
+	/* An asserted top-level NPU reset is the terminal DMA fence. */
+	err = reset_control_assert(npu->rst);
+	status = reset_control_status(npu->rst);
+	if (status < 0) {
+		if (!err)
+			err = status;
+	} else if (!status) {
+		if (!err)
+			err = -EIO;
+	} else {
+		atomic_set_release(&npu->hard_stopped, 1);
+		err = 0;
+	}
+
+	npu->recovery_err = -ESHUTDOWN;
+unlock:
+	mutex_unlock(&npu->recovery_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_npu_hard_stop);
