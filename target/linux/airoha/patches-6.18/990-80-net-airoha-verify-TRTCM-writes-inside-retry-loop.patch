From: Lorenzo Bianconi <lorenzo@kernel.org>
Subject: [PATCH] net: airoha: verify TRTCM parameter writes inside retry loop

airoha_qdma_set_trtcm_param() already retries TRTCM parameter writes, but
it verifies the readback before polling RW_DONE for the write that just
started. That can validate a stale value and leaves the final RW_DONE poll
outside the retry loop, so timeout failures are not retried consistently.

Poll RW_DONE after each trigger write, verify the committed value with a
readback, and retry both timeout and readback failures before returning
-EBUSY.

Signed-off-by: Lorenzo Bianconi <lorenzo@kernel.org>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -3603,8 +3603,7 @@
 				       u32 addr, enum trtcm_param_type param,
 				       enum trtcm_mode_type mode, u32 val)
 {
-	u32 value_lo = 0, value_hi = 0;
-	int retry_num = 100;
+	int i;
 	u32 idx = QDMA_METER_IDX(channel), group = QDMA_METER_GROUP(channel);
 	u32 config = TRTCM_PARAM_RW_MASK |
 		     FIELD_PREP(TRTCM_PARAM_TYPE_MASK, param) |
@@ -3612,20 +3611,29 @@
 		     FIELD_PREP(TRTCM_PARAM_INDEX_MASK, idx) |
 		     FIELD_PREP(TRTCM_PARAM_RATE_TYPE_MASK, mode);
 
-	do {
+	for (i = 0; i < 100; i++) {
+		u32 data = 0;
+
 		airoha_qdma_wr(qdma, REG_TRTCM_DATA_LOW(addr), val);
 		wmb();
 		airoha_qdma_wr(qdma, REG_TRTCM_CFG_PARAM(addr), config);
-		airoha_qdma_get_trtcm_param(qdma, channel, addr, param, mode,
-					    &value_lo, &value_hi);
-		if (val == value_lo)
-			break;
-	} while (--retry_num);
-
-	return read_poll_timeout(airoha_qdma_rr, val,
-				 val & TRTCM_PARAM_RW_DONE_MASK,
-				 USEC_PER_MSEC, 10 * USEC_PER_MSEC, true,
-				 qdma, REG_TRTCM_CFG_PARAM(addr));
+		wmb();
+
+		if (read_poll_timeout(airoha_qdma_rr, data,
+				      data & TRTCM_PARAM_RW_DONE_MASK,
+				      USEC_PER_MSEC, 10 * USEC_PER_MSEC,
+				      true, qdma, REG_TRTCM_CFG_PARAM(addr)))
+			continue;
+
+		if (airoha_qdma_get_trtcm_param(qdma, channel, addr, param, mode,
+					    &data, NULL))
+			continue;
+
+		if (data == val)
+			return 0;
+	}
+
+	return -EBUSY;
 }
 
 static int airoha_qdma_set_trtcm_config(struct airoha_qdma *qdma, int channel,
