From: naoki66 <naoki66@qq.com>
Subject: [PATCH] net: pcs: airoha: track AN7581 RX-lock resets

Some Gemtek XR1710G units report a valid copper-side link from the
RTL8261BE while the AN7581 Ethernet PCS never reports USXGMII carrier.
Track CDR resets caused by the RX-lock workaround and report the
relevant PCS, Base-R, autonegotiation, SigDet, FreqDet and reset
registers only when recovery is triggered. A missing SerDes signal is a
normal link-down sample and does not emit a polling log.

Signed-off-by: naoki66 <naoki66@qq.com>
---
 drivers/net/pcs/airoha/pcs-airoha.h |  2 ++
 drivers/net/pcs/airoha/pcs-an7581.c | 36 ++++++++++++++++++++++++++++++++----
 2 files changed, 35 insertions(+), 3 deletions(-)

--- a/drivers/net/pcs/airoha/pcs-airoha.h
+++ b/drivers/net/pcs/airoha/pcs-airoha.h
@@ -1657,6 +1657,8 @@ struct airoha_pcs_priv {
 	struct reset_control *xfi_rst;
 	struct reset_control_bulk_data rsts[AIROHA_PCS_MAX_NUM_RSTS];
 
+	u32 rxlock_reset_count[2];
+
 	struct phy *phy;
 
 	bool manual_rx_calib;
diff --git a/drivers/net/pcs/airoha/pcs-an7581.c b/drivers/net/pcs/airoha/pcs-an7581.c
index 6deb95331ab..fb0888d2d85 100644
--- a/drivers/net/pcs/airoha/pcs-an7581.c
+++ b/drivers/net/pcs/airoha/pcs-an7581.c
@@ -2117,9 +2117,37 @@ static bool an7581_pcs_have_rx_signal(struct airoha_pcs_priv *priv, int index)
 	return count >= 4;
 }
 
+static void an7581_pcs_report_rxlock(struct airoha_pcs_priv *priv, int index,
+				     u32 pcs_status, bool signal,
+				     const char *action)
+{
+	struct airoha_pcs_maps *maps = &priv->maps[index];
+	struct regmap *pcs_pma = priv->pcs_pma[index];
+	u32 base_r = 0, an_status = 0, an_done = 0;
+	u32 freqdet = 0, rst = 0;
+
+	regmap_read(maps->usxgmii_pcs,
+		    AIROHA_PCS_USXGMII_BASE_R_10GB_T_PCS_STUS_1, &base_r);
+	regmap_read(maps->usxgmii_pcs,
+		    AIROHA_PCS_USXGMII_PCS_AN_STATS_0, &an_status);
+	regmap_read(maps->usxgmii_pcs,
+		    AIROHA_PCS_USXGMII_PCS_AN_STATS_2, &an_done);
+	regmap_read(pcs_pma, AIROHA_PCS_PMA_RX_FREQDET, &freqdet);
+	regmap_read(pcs_pma, AIROHA_PCS_PMA_SW_RST_SET, &rst);
+
+	if (!signal)
+		return;
+
+	dev_info_ratelimited(priv->dev,
+			     "port %d USXGMII RX: pcs=%#010x base-r=%#010x an=%#010x an-done=%#010x sigdet=%u freqdet=%#010x rst=%#010x action=%s resets=%u\n",
+			     index, pcs_status, base_r, an_status, an_done, signal,
+			     freqdet, rst, action, priv->rxlock_reset_count[index]);
+}
+
 int an7581_pcs_rxlock_workaround(struct airoha_pcs_priv *priv, int index)
 {
 	struct airoha_pcs_maps *maps = &priv->maps[index];
+	bool signal;
 	u32 val;
 
 	/* Check if PCS is UP or Down */
@@ -2127,14 +2152,16 @@ int an7581_pcs_rxlock_workaround(struct airoha_pcs_priv *priv, int index)
 	if (val & AIROHA_PCS_USXGMII_PCS_RX_LINK_STATUS_UP)
 		return 0;
 
-	/* Validate if this is consistent with RX SigDet module */
-	if (!an7581_pcs_have_rx_signal(priv, index))
+	signal = an7581_pcs_have_rx_signal(priv, index);
+	if (!signal)
 		return 0;
 
 	/* If PCS is down but RX SigDet module detected signal,
 	 * trigger CDR reset.
 	 */
-	an7581_pcs_cdr_reset(priv, index, PHY_INTERFACE_MODE_NA, false);
+	priv->rxlock_reset_count[index]++;
+	an7581_pcs_report_rxlock(priv, index, val, true, "cdr-reset");
+	an7581_pcs_cdr_reset(priv, index, PHY_INTERFACE_MODE_NA, false);
 
 	/* Report there is an error with Link Detection and we
 	 * should test again later.
-- 
2.51.0
