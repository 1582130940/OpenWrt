From c79f33f3501a867aff30763e937d1fa868ec36c7 Mon Sep 17 00:00:00 2001
From: HandSonic <8078023+handsonic@users.noreply.github.com>
Date: Sun, 30 Aug 2026 23:00:42 +0800
Subject: [PATCH 4/8] dt-bindings: net: airoha: describe NPU reset and memory

Document the AN7583 compatible string, the NPU reset line, supported
firmware-name pairs, and the memory layouts used by EN7581 and AN7583
device trees.

Require memory-region-names so the driver can distinguish the optional
mailbox pool from other reserved regions.

Signed-off-by: HandSonic <8078023+handsonic@users.noreply.github.com>
---
 .../bindings/net/airoha,en7581-npu.yaml       | 75 +++++++++++++++++--
 1 file changed, 67 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml b/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml
index c7644e658..252cf07e7 100644
--- a/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/net/airoha,en7581-npu.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Airoha Network Processor Unit for EN7581 SoC
+title: Airoha Network Processor Unit for EN7581 and AN7583 SoCs
 
 maintainers:
   - Lorenzo Bianconi <lorenzo@kernel.org>
@@ -18,10 +18,17 @@ properties:
   compatible:
     enum:
       - airoha,en7581-npu
+      - airoha,an7583-npu
 
   reg:
     maxItems: 1
 
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: npu
+
   interrupts:
     items:
       - description: mbox host irq line
@@ -40,28 +47,77 @@ properties:
       - description: wlan irq line4
       - description: wlan irq line5
 
+  firmware-name:
+    minItems: 2
+    maxItems: 2
+    items:
+      - description: NPU RV32 firmware image
+      - description: NPU data firmware image
+
   memory-region:
     oneOf:
-      - items:
+      - minItems: 1
+        maxItems: 1
+        items:
+          - description: NPU firmware binary region
+      - minItems: 2
+        maxItems: 2
+        items:
           - description: NPU firmware binary region
-      - items:
+          - description: NPU mailbox DMA region
+      - minItems: 4
+        maxItems: 4
+        items:
           - description: NPU firmware binary region
           - description: NPU wlan offload RX buffers region
           - description: NPU wlan offload TX buffers region
           - description: NPU wlan offload TX packet identifiers region
+      - minItems: 6
+        maxItems: 6
+        items:
+          - description: NPU firmware binary region
+          - description: NPU wlan offload RX buffers region
+          - description: NPU wlan offload TX buffers region
+          - description: NPU wlan offload TX packet identifiers region
+          - description: NPU block-ack state region
+          - description: NPU mailbox DMA region
 
   memory-region-names:
-    items:
-      - const: firmware
-      - const: pkt
-      - const: tx-pkt
-      - const: tx-bufid
+    oneOf:
+      - minItems: 1
+        maxItems: 1
+        items:
+          - enum: [ firmware, binary ]
+      - minItems: 2
+        maxItems: 2
+        items:
+          - const: binary
+          - const: mbox
+      - minItems: 4
+        maxItems: 4
+        items:
+          - enum: [ firmware, binary ]
+          - const: pkt
+          - const: tx-pkt
+          - const: tx-bufid
+      - minItems: 6
+        maxItems: 6
+        items:
+          - const: binary
+          - const: pkt
+          - const: tx-pkt
+          - const: tx-bufid
+          - const: ba
+          - const: mbox
 
 required:
   - compatible
   - reg
+  - resets
+  - reset-names
   - interrupts
   - memory-region
+  - memory-region-names
 
 additionalProperties: false
 
@@ -69,6 +125,7 @@ examples:
   - |
     #include <dt-bindings/interrupt-controller/arm-gic.h>
     #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/reset/airoha,en7581-reset.h>
     soc {
       #address-cells = <2>;
       #size-cells = <2>;
@@ -76,6 +133,8 @@ examples:
       npu@1e900000 {
         compatible = "airoha,en7581-npu";
         reg = <0 0x1e900000 0 0x313000>;
+        resets = <&scuclk EN7581_NPU_RST>;
+        reset-names = "npu";
         interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>,
                      <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>,
                      <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
