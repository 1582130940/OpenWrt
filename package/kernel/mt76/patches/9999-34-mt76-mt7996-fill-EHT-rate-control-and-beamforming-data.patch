From: Jihong Min <hurryman2212@gmail.com>
Date: Wed, 20 May 2026 07:14:53 +0900
Subject: [PATCH] wifi: mt76: mt7996: fill EHT rate control and beamforming data

mt7996_mcu_sta_rate_ctrl_tlv() marks HE-capable stations with MODE_HE but
never sets MODE_EHT, so firmware has to infer an EHT peer from the other
station records instead of the rate-control input.

mt7996_mcu_sta_bfer_eht() packs the >80 MHz beamforming row and column
counts into separate 160 MHz and 320 MHz nibbles, but the 320 MHz branch
leaves the 160 MHz nibble at zero, so a sounding bandwidth that contracts
from 320 MHz to 160 MHz has no fallback matrix.

Set MODE_EHT for EHT-capable stations and populate both nibbles.

Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
diff --git a/mt7996/mcu.c b/mt7996/mcu.c
index 82253da0..170f8335 100644
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -2197,6 +2197,15 @@ mt7996_mcu_sta_bfer_eht(struct ieee80211_link_sta *link_sta,
 		bf->ncol_gt_bw80 = nss_mcs;
 		break;
 	case IEEE80211_STA_RX_BW_320:
+		bf->nrow_gt_bw80 =
+			min_t(u8, EHT_PHY(CAP2_SOUNDING_DIM_160MHZ_MASK,
+					  ve->phy_cap_info[2]),
+			      EHT_PHY(CAP1_BEAMFORMEE_SS_160MHZ_MASK,
+				      pe->phy_cap_info[1]));
+		nss_mcs = u8_get_bits(eht_nss->bw._160.rx_tx_mcs9_max_nss,
+				      IEEE80211_EHT_MCS_NSS_RX);
+		bf->ncol_gt_bw80 = nss_mcs ? nss_mcs - 1 : 0;
+
 		snd_dim = EHT_PHY(CAP2_SOUNDING_DIM_320MHZ_MASK, ve->phy_cap_info[2]) +
 			  (EHT_PHY(CAP3_SOUNDING_DIM_320MHZ_MASK,
 				   ve->phy_cap_info[3]) << 1);
@@ -2205,8 +2214,8 @@ mt7996_mcu_sta_bfer_eht(struct ieee80211_link_sta *link_sta,
 				      IEEE80211_EHT_MCS_NSS_RX);
 		nss_mcs = nss_mcs ? nss_mcs - 1 : 0;
 
-		bf->nrow_gt_bw80 = min_t(u8, snd_dim, sts) << 4;
-		bf->ncol_gt_bw80 = nss_mcs << 4;
+		bf->nrow_gt_bw80 |= min_t(u8, snd_dim, sts) << 4;
+		bf->ncol_gt_bw80 |= nss_mcs << 4;
 		break;
 	default:
 		break;
@@ -2744,6 +2753,10 @@ mt7996_mcu_sta_rate_ctrl_tlv(struct sk_buff *skb, struct mt7996_dev *dev,
 			ra->af = le16_get_bits(link_sta->he_6ghz_capa.capa,
 					       IEEE80211_HE_6GHZ_CAP_MAX_AMPDU_LEN_EXP);
 	}
+
+	if (link_sta->eht_cap.has_eht)
+		ra->supp_mode |= MODE_EHT;
+
 	ra->sta_cap = cpu_to_le32(cap);
 
 	memset(ra->rx_rcpi, INIT_RCPI, sizeof(ra->rx_rcpi));
