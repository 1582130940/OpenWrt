From dd8f747bffd6f5b003339b696f436fd2276cf783 Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sun, 30 Aug 2026 21:51:43 +0800
Subject: [PATCH 04/12] wifi: mt76: replay and quarantine NPU DMA state

Remember the NPU DMA resources that were successfully configured so
reset recovery can replay them. If recovery cannot rebuild the original
state, leave the device quarantined instead of publishing stale queues.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 dma.c           |  28 ++++++++++++
 mac80211.c      |   2 +
 mt76.h          |  24 +++++++++++
 mt7996/init.c   |  84 ++++++++++++++++++++++++++----------
 mt7996/mac.c    |  15 +++++--
 mt7996/mt7996.h |  13 +++++-
 mt7996/npu.c    |  49 ++++++++++++++++++---
 mt7996/pci.c    |  21 ++++++---
 npu.c           | 111 ++++++++++++++++++++++++++++++++----------------
 9 files changed, 273 insertions(+), 74 deletions(-)

diff --git a/dma.c b/dma.c
index 0b9c6e2..e46793e 100644
--- a/dma.c
+++ b/dma.c
@@ -829,6 +829,7 @@ int mt76_dma_rx_fill(struct mt76_dev *dev, struct mt76_queue *q,
 }
 
 struct mt76_dma_allocation {
+	struct list_head list;
 	struct device *dma_dev;
 	void *vaddr;
 	dma_addr_t dma_addr;
@@ -868,8 +869,18 @@ void *mt76_dma_alloc_coherent(struct mt76_dev *dev, size_t size,
 		return NULL;
 	}
 
+	mutex_lock(&dev->dma_alloc_mutex);
+	if (dev->dma_alloc_quarantined) {
+		mutex_unlock(&dev->dma_alloc_mutex);
+		mt76_dma_free_coherent(allocation);
+		return NULL;
+	}
+
 	err = devm_add_action_or_reset(dev->dev, mt76_dma_free_coherent,
 				       allocation);
+	if (!err)
+		list_add_tail(&allocation->list, &dev->dma_allocations);
+	mutex_unlock(&dev->dma_alloc_mutex);
 	if (err)
 		return NULL;
 
@@ -879,6 +890,23 @@ void *mt76_dma_alloc_coherent(struct mt76_dev *dev, size_t size,
 }
 EXPORT_SYMBOL_GPL(mt76_dma_alloc_coherent);
 
+void mt76_dma_quarantine_allocations(struct mt76_dev *dev)
+{
+	struct mt76_dma_allocation *allocation, *tmp;
+	LIST_HEAD(list);
+
+	mutex_lock(&dev->dma_alloc_mutex);
+	dev->dma_alloc_quarantined = true;
+	list_splice_init(&dev->dma_allocations, &list);
+	mutex_unlock(&dev->dma_alloc_mutex);
+
+	list_for_each_entry_safe(allocation, tmp, &list, list) {
+		devm_remove_action(dev->dev, mt76_dma_free_coherent, allocation);
+		list_del_init(&allocation->list);
+	}
+}
+EXPORT_SYMBOL_GPL(mt76_dma_quarantine_allocations);
+
 static int
 mt76_dma_alloc_queue(struct mt76_dev *dev, struct mt76_queue *q,
 		     int idx, int n_desc, int bufsize,
