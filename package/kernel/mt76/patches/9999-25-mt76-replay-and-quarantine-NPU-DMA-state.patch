 				    struct airoha_npu *npu, int err,
 				    const char *operation)
@@ -597,9 +613,15 @@ static int mt7996_npu_prepare_retry(struct mt7996_dev *dev,
 	dev_warn(dev->mt76.dev, "%s timed out, recovering mailbox\n",
 		 operation);
 	err = airoha_npu_recover_mailbox(npu);
-	if (err)
-		dev_err(dev->mt76.dev, "failed to recover NPU mailbox: %d\n",
-			err);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "NPU mailbox health check failed: %d; forcing recovery\n",
+			 err);
+		err = airoha_npu_recover(npu);
+		if (err)
+			dev_err(dev->mt76.dev,
+				"failed to recover NPU core 0: %d\n", err);
+	}
 
 	return err;
 }
