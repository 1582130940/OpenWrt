+		mt7996_quarantine_device(dev);
+		return err;
+	}
 
 	mt76_npu_disable_irqs(&dev->mt76);
 	mt7996_irq_disable(dev, ~0);
@@ -1945,4 +1983,6 @@ void mt7996_shutdown_device(struct mt7996_dev *dev)
 		dev->recovery.hw_full_reset = true;
 		mt7996_wfsys_reset(dev);
 	}
+
+	return 0;
 }
