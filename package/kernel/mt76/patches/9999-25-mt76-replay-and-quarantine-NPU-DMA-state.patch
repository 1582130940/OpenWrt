+int mt76_npu_init_reserved_memory(struct mt76_dev *dev,
+				  struct airoha_npu *npu)
+{
+	bool retry;
+	int err;
+
+	lockdep_assert_held(&dev->mutex);
+
+	err = airoha_npu_wlan_init_reserved_memory(npu);
+	retry = err == -ETIMEDOUT || err == -EAGAIN;
+	if (err == -EAGAIN) {
+		dev_warn(dev->dev,
+			 "NPU memory initialization interrupted by recovery, waiting\n");
+		err = airoha_npu_wait_recovery(npu);
+		if (err) {
+			dev_err(dev->dev, "NPU recovery failed: %d\n", err);
+			return err;
+		}
+	} else if (err == -ETIMEDOUT) {
+		dev_warn(dev->dev,
+			 "NPU memory initialization timed out, recovering mailbox\n");
+		err = airoha_npu_recover_mailbox(npu);
+		if (err) {
+			dev_warn(dev->dev,
+				 "NPU mailbox health check failed: %d; forcing recovery\n",
+				 err);
+			err = airoha_npu_recover(npu);
+			if (err) {
+				dev_err(dev->dev,
+					"failed to recover NPU core 0: %d\n", err);
+				return err;
+			}
+		}
+	}
+
+	if (retry) {
+		err = airoha_npu_wlan_init_reserved_memory(npu);
+		if (err)
+			dev_err(dev->dev,
+				"NPU memory initialization retry failed: %d\n",
+				err);
+	}
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(mt76_npu_init_reserved_memory);
