+static int mt7996_npu_full_init_once(struct mt7996_dev *dev,
+				     struct airoha_npu *npu)
+{
+	int err;
+
+	err = mt76_npu_init_reserved_memory(&dev->mt76, npu);
+	if (err)
+		return err;
+
+	err = __mt7996_npu_rro_addr_init(dev);
+	if (err)
+		return err;
+
+	return mt7996_npu_hw_init_once(dev, npu);
+}
+
