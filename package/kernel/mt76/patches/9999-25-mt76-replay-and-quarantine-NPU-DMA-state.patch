-	err = mt7996_npu_hw_init_once(dev, npu);
+	err = mt7996_npu_full_init_once(dev, npu);
 	if (err != -ETIMEDOUT && err != -EAGAIN)
 		return err;
 
@@ -622,7 +644,7 @@ int __mt7996_npu_hw_init(struct mt7996_dev *dev)
 	if (err)
 		return err;
 
-	err = mt7996_npu_hw_init_once(dev, npu);
+	err = mt7996_npu_full_init_once(dev, npu);
 	if (err)
 		dev_err(dev->mt76.dev,
 			"NPU hardware initialization retry failed: %d\n", err);
@@ -665,6 +687,21 @@ int mt7996_npu_hw_init(struct mt7996_dev *dev)
 	return err;
 }
 
+int mt7996_npu_hw_recover(struct mt7996_dev *dev)
+{
+	struct airoha_npu *npu;
+	int err = 0;
+
+	mutex_lock(&dev->mt76.mutex);
+	npu = rcu_dereference_protected(dev->mt76.mmio.npu,
+					lockdep_is_held(&dev->mt76.mutex));
+	if (npu)
+		err = airoha_npu_recover(npu);
+	mutex_unlock(&dev->mt76.mutex);
+
+	return err;
+}
+
 static int mt7996_npu_hw_stop_once(struct mt7996_dev *dev,
