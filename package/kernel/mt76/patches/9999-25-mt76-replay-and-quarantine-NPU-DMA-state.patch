diff --git a/mt7996/init.c b/mt7996/init.c
index 8225a16..733a925 100644
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -984,12 +984,35 @@ void mt7996_rro_hw_init(struct mt7996_dev *dev)
 		MT_RRO_HOST_INT_ENA_HOST_RRO_DONE_ENA);
 }
 
+int __mt7996_npu_rro_addr_init(struct mt7996_dev *dev)
+{
+	int i, err;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+
+	if (!is_mt7996(&dev->mt76) ||
+	    !mt76_npu_device_active(&dev->mt76))
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(dev->wed_rro.addr_elem); i++) {
+		err = __mt76_npu_send_txrx_addr(&dev->mt76, 0, i,
+						dev->wed_rro.addr_elem[i].phy_addr,
+						0, 0);
+		if (err)
+			return err;
+	}
+
+	return __mt76_npu_send_txrx_addr(&dev->mt76, 1, 0,
+						 dev->wed_rro.session.phy_addr,
+						 0, 0);
+}
