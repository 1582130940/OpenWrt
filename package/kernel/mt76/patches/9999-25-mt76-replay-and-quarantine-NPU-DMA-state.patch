-						      0, 0);
-			if (err)
-				return err;
-		}
-
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
 		if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
 		    mtk_wed_get_rx_capa(&dev->mt76.mmio.wed)) {
@@ -1096,14 +1110,6 @@ static int mt7996_wed_rro_init(struct mt7996_dev *dev)
 		addr++;
 	}
 
-	if (is_mt7996(&dev->mt76) && mt76_npu_device_active(&dev->mt76)) {
-		err = mt76_npu_send_txrx_addr(&dev->mt76, 1, 0,
-					      dev->wed_rro.session.phy_addr,
-					      0, 0);
-		if (err)
-			return err;
-	}
-
 	mt7996_rro_hw_init(dev);
 
 	return mt7996_dma_rro_init(dev);
@@ -1206,6 +1212,9 @@ static void mt7996_wed_rro_work(struct work_struct *work)
 					/* The NPU may still reference this session. Do not
 					 * tell the WLAN firmware that it can be reused.
 					 */
+					dev->recovery.npu_reset = true;
+					dev->recovery.restart = true;
+					queue_work(dev->mt76.wq, &dev->reset_work);
 					goto out;
 				}
 			}
@@ -1882,7 +1891,30 @@ error:
 	return ret;
 }
 
-void mt7996_unregister_device(struct mt7996_dev *dev)
+void mt7996_quarantine_device(struct mt7996_dev *dev)
+{
+	dev->recovery.hw_full_reset = true;
+	cancel_work_sync(&dev->dump_work);
+	cancel_work_sync(&dev->reset_work);
+	dev->recovery.hw_full_reset = true;
+	mt7996_wed_rro_work_stop(dev);
+	cancel_work_sync(&dev->rc_work);
+
+	if (test_bit(MT76_STATE_REGISTERED, &dev->mphy.state))
+		ieee80211_stop_queues(mt76_hw(dev));
+	mt76_worker_disable(&dev->mt76.tx_worker);
+
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed);
+
+	mt76_npu_disable_irqs(&dev->mt76);
+	mt7996_irq_disable(dev, ~0);
+	mt7996_dma_disable(dev, true);
+}
