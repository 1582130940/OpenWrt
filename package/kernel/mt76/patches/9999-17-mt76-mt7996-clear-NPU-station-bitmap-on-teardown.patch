From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gilly1970 <gilroyscott@hotmail.com>
Date: Thu, 4 Aug 2026 18:47:28 +1000
Subject: [PATCH] wifi: mt76: mt7996: clear NPU station bitmap on teardown

The Airoha NPU keeps a per-WCID station bitmap in its RRO SRAM that its
firmware does not clear on its own. When a station disconnects and a
reconnecting station is later handed the same WCID, the inherited stale
bits can wedge that station's forwarded/uplink offload path.

Clear the departing WCID's bitmap for each normal TID before the WCID is
unpublished and can be reused. The DEL_STA command is present in the
current NPU ABI and only touches the selected WCID/TID entry.

Signed-off-by: Gilly1970 <gilroyscott@hotmail.com>
---
 mt7996/main.c   |  2 ++
 mt7996/mt7996.h |  6 ++++++
 mt7996/npu.c    | 25 +++++++++++++++++++++++++
 3 files changed, 33 insertions(+)

--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1262,6 +1262,8 @@ void mt7996_mac_sta_remove_link(struct
 		if (phy)
 			phy->mt76->num_sta--;
 
+		mt7996_npu_sta_remove(dev, &msta_link->wcid);
+
 		rcu_assign_pointer(msta->link[link_id], NULL);
 		rcu_assign_pointer(dev->mt76.wcid[msta_link->wcid.idx], NULL);
 		mt76_wcid_mask_clear(dev->mt76.wcid_mask, msta_link->wcid.idx);
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -1012,6 +1012,7 @@ int mt7996_npu_hw_init(struct mt7996_dev
 int mt7996_npu_hw_stop(struct mt7996_dev *dev);
 int mt7996_npu_hw_stop_teardown(struct mt7996_dev *dev);
 int mt7996_npu_rx_queues_init(struct mt7996_dev *dev);
+void mt7996_npu_sta_remove(struct mt7996_dev *dev, struct mt76_wcid *wcid);
 #else
 static inline int __mt7996_npu_hw_init(struct mt7996_dev *dev)
 {
@@ -1037,6 +1038,11 @@ static inline int mt7996_npu_rx_queues_i
 {
 	return 0;
 }
+
+static inline void mt7996_npu_sta_remove(struct mt7996_dev *dev,
+						 struct mt76_wcid *wcid)
+{
+}
 #endif /* CONFIG_MT7996_NPU */
 
 #endif
--- a/mt7996/npu.c
+++ b/mt7996/npu.c
@@ -197,6 +197,31 @@ static int mt7996_npu_txrx_offload_init(
 	return 0;
 }
 
+#define MT7996_NPU_STA_BITMAP_CLEAR	1
+
+void mt7996_npu_sta_remove(struct mt7996_dev *dev, struct mt76_wcid *wcid)
+{
+	struct airoha_npu *npu;
+	u32 tid;
+
+	if (wcid->idx > 0x7ff)
+		return;
+
+	rcu_read_lock();
+	npu = rcu_dereference(dev->mt76.mmio.npu);
+	if (!npu)
+		goto out;
+
+	for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++)
+		mt76_npu_send_msg(npu, MT7996_NPU_STA_BITMAP_CLEAR,
+				  WLAN_FUNC_SET_WAIT_DEL_STA,
+				  (tid << 11) | wcid->idx,
+				  GFP_ATOMIC);
+
+out:
+	rcu_read_unlock();
+}
+
 static int mt7996_npu_offload_init(struct mt7996_dev *dev,
 					   struct airoha_npu *npu)
 {
