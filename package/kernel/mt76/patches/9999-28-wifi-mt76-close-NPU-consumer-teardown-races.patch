+void mt7996_wed_rro_purge(struct mt7996_dev *dev)
+{
+	struct mt7996_wed_rro_session_id *session, *tmp;
+	LIST_HEAD(list);
+
+	spin_lock_bh(&dev->wed_rro.lock);
+	list_splice_init(&dev->wed_rro.poll_list, &list);
+	spin_unlock_bh(&dev->wed_rro.lock);
+
+	list_for_each_entry_safe(session, tmp, &list, list) {
+		list_del_init(&session->list);
+		kfree(session);
+	}
+}
