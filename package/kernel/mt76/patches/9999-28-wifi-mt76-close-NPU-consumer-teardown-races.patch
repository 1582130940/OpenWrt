+#define MT76_NAPI_TX	__MT_RXQ_MAX
+
+static inline void mt76_napi_enable(struct mt76_dev *dev, int id,
+				    struct napi_struct *napi)
+{
+	if (dev->napi_state_tracked &&
+	    test_and_set_bit(id, &dev->napi_enabled))
+		return;
+
+	napi_enable(napi);
+}
+
+static inline void mt76_napi_disable(struct mt76_dev *dev, int id,
+				     struct napi_struct *napi)
+{
+	if (dev->napi_state_tracked &&
+	    !test_and_clear_bit(id, &dev->napi_enabled))
+		return;
+
+	napi_disable(napi);
+}
+
 static inline bool mt76_ppe_device_active(struct mt76_dev *dev)
 {
 	return mt76_is_mmio(dev) && !!rcu_access_pointer(dev->mmio.ppe_dev);
