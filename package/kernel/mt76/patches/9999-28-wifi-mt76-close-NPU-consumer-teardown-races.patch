+
+void mt7996_terminal_quiesce(struct mt7996_dev *dev)
+{
+	struct mt7996_phy *phy;
+
+	WRITE_ONCE(dev->terminal, true);
 	dev->recovery.hw_full_reset = true;
+	mt7996_npu_pre_stop(dev);
+
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->reset_work);
-	dev->recovery.hw_full_reset = true;
-	mt7996_wed_rro_work_stop(dev);
+	cancel_work_sync(&dev->init_work);
 	cancel_work_sync(&dev->rc_work);
-	err = mt7996_npu_hw_stop_teardown(dev);
-	if (err) {
-		dev_crit(dev->mt76.dev,
-			 "failed to fence NPU DMA; refusing to release resources: %d\n",
-			 err);
-		mt7996_quarantine_device(dev);
-		return err;
+	/* A running reset may have restored producers before cancel returned. */
+	mt7996_npu_pre_stop(dev);
+	mt7996_wed_rro_purge(dev);
+	mt76_abort_scan(&dev->mt76);
+	mt7996_for_each_phy(dev, phy) {
+		mt76_abort_roc(phy->mt76);
+		cancel_delayed_work_sync(&phy->mt76->mac_work);
 	}
+
+	dev->recovery.hw_full_reset = true;
+	set_bit(MT76_MCU_RESET, &dev->mphy.state);
+	mt7996_for_each_phy(dev, phy)
+		set_bit(MT76_RESET, &phy->mt76->state);
+}
+
+void mt7996_quarantine_device(struct mt7996_dev *dev)
+{
+	mt7996_terminal_quiesce(dev);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+}
+
+void __noreturn mt7996_fence_failed(struct mt7996_dev *dev,
+				    const char *phase, int err)
+{
+	mt7996_quarantine_device(dev);
+	panic("%s: unrecoverable NPU DMA fence failure during %s: %d\n",
+	      dev_name(dev->mt76.dev), phase, err);
+}
