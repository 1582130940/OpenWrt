From: Yanghan Ye <yyh94306@gmail.com>
Date: Tue, 18 Aug 2026 00:01:30 +0800
Subject: [PATCH] wifi: mt76: track RX NAPI registration

mt76_dma_init() skips WED RRO queues because hardware-offloaded queues do
not use NAPI. When WED is inactive, however, mt7996_dma_rro_start() later
registers NAPI for those same software-handled queues.

Cleanup currently checks only the WED RRO flag and leaves those NAPI
instances enabled and registered. It also iterates only queues with active
descriptors, although an earlier teardown stage can release a queue before
the dummy netdev is freed. This triggers warnings when free_netdev() removes
the remaining NAPI instances.

Track RX NAPI registration in the device independently of queue allocation
state. Walk the complete RX NAPI array during final cleanup, and destroy each
page pool before deleting its NAPI instance so the association remains valid
throughout teardown. Reuse the same registration state for the NPU RX queues.

Fixes: 332bbe9b2784 ("wifi: mt76: Disable napi when removing device")
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
	dma.c  | 21 ++++++++++++++++-----
	mt76.h |  2 +-
	npu.c  |  8 ++++----
	3 files changed, 21 insertions(+), 10 deletions(-)

--- a/dma.c
+++ b/dma.c
@@ -1181,8 +1181,11 @@ static void
 mt76_dma_rx_queue_init(struct mt76_dev *dev, enum mt76_rxq_id qid,
 		       int (*poll)(struct napi_struct *napi, int budget))
 {
+	struct mt76_queue *q = &dev->q_rx[qid];
+
 	netif_napi_add(dev->napi_dev, &dev->napi[qid], poll);
-	mt76_dma_rx_fill_buf(dev, &dev->q_rx[qid], false);
+	set_bit(qid, &dev->napi_registered);
+	mt76_dma_rx_fill_buf(dev, q, false);
 	napi_enable(&dev->napi[qid]);
 }
 
@@ -1268,13 +1271,22 @@ void mt76_dma_cleanup(struct mt76_dev *dev)
 	for (i = 0; i < ARRAY_SIZE(dev->q_mcu); i++)
 		mt76_dma_tx_cleanup(dev, dev->q_mcu[i], true);
 
-	mt76_for_each_q_rx(dev, i) {
+	for (i = 0; i < ARRAY_SIZE(dev->q_rx); i++) {
 		struct mt76_queue *q = &dev->q_rx[i];
+		bool napi_registered = test_bit(i, &dev->napi_registered);
 
-		netif_napi_del(&dev->napi[i]);
-		mt76_dma_rx_cleanup(dev, q);
+		if (q->ndesc)
+			mt76_dma_rx_cleanup(dev, q);
 
-		page_pool_destroy(q->page_pool);
+		if (q->page_pool) {
+			page_pool_destroy(q->page_pool);
+			q->page_pool = NULL;
+		}
+
+		if (napi_registered) {
+			netif_napi_del(&dev->napi[i]);
+			clear_bit(i, &dev->napi_registered);
+		}
 	}
 
 	if (mtk_wed_device_active(&dev->mmio.wed))
--- a/mt76.h
+++ b/mt76.h
@@ -264,7 +264,6 @@ struct mt76_queue {
 	int npu_irq;
 	bool stopped;
 	bool blocked;
-	bool npu_napi_registered;
 	bool npu_irq_registered;
 
 	u8 buf_offset;
@@ -966,6 +965,7 @@ struct mt76_dev {
 	struct net_device *tx_napi_dev;
 	spinlock_t rx_lock;
 	struct napi_struct napi[__MT_RXQ_MAX];
+	unsigned long napi_registered;
 	struct sk_buff_head rx_skb[__MT_RXQ_MAX];
 	struct tasklet_struct irq_tasklet;
 
--- a/npu.c
+++ b/npu.c
@@ -322,7 +322,7 @@ int mt76_npu_rx_queue_init(struct mt76_dev *dev, struct mt76_queue *q)
 	}
 
 	netif_napi_add(dev->napi_dev, &dev->napi[qid], mt76_npu_rx_poll);
-	WRITE_ONCE(q->npu_napi_registered, true);
+	set_bit(qid, &dev->napi_registered);
 	mt76_npu_fill_rx_queue(dev, q);
 	napi_enable(&dev->napi[qid]);
 
@@ -339,10 +339,10 @@ int mt76_npu_rx_queue_init(struct mt76_dev *dev, struct mt76_queue *q)
 	goto out;
 
 error_queue:
-	if (READ_ONCE(q->npu_napi_registered)) {
+	if (test_bit(qid, &dev->napi_registered)) {
 		napi_disable(&dev->napi[qid]);
 		netif_napi_del(&dev->napi[qid]);
-		WRITE_ONCE(q->npu_napi_registered, false);
+		clear_bit(qid, &dev->napi_registered);
 	}
 	if (q->page_pool) {
 		mt76_npu_queue_cleanup(dev, q);
@@ -374,7 +374,7 @@ void mt76_npu_rx_queues_deinit(struct mt76_dev *dev)
 		u32 status;
 
 		irq_registered = READ_ONCE(q->npu_irq_registered);
-		napi_registered = READ_ONCE(q->npu_napi_registered);
+		napi_registered = test_bit(i, &dev->napi_registered);
 		if (irq_registered) {
 			WRITE_ONCE(q->npu_irq_registered, false);
 			if (npu) {
@@ -390,7 +390,7 @@ void mt76_npu_rx_queues_deinit(struct mt76_dev *dev)
 		if (napi_registered) {
 			napi_disable(&dev->napi[i]);
 			netif_napi_del(&dev->napi[i]);
-			WRITE_ONCE(q->npu_napi_registered, false);
+			clear_bit(i, &dev->napi_registered);
 		}
 
 		/* A poll already completing can race the first IRQ mask. */
