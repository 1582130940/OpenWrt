From faab0ff828967ebf0f5438f14ff9dea0d02fa5db Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sun, 30 Aug 2026 21:51:43 +0800
Subject: [PATCH 03/12] wifi: mt76: fail closed on NPU recovery errors

Treat failed full-reset or NPU reinitialization as terminal instead of
continuing with partially restored DMA state. Stop active WED devices on
the failure path before quarantining the device.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 mt7996/mac.c | 89 +++++++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 74 insertions(+), 15 deletions(-)

diff --git a/mt7996/mac.c b/mt7996/mac.c
index 66f7507..ab4aa12 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2328,13 +2328,28 @@ mt7996_mac_reset_vif_iter(void *data, u8 *mac, struct ieee80211_vif *vif)
 	rcu_read_unlock();
 }
 
-static void
-mt7996_mac_full_reset(struct mt7996_dev *dev)
+static void mt7996_npu_recovery_failed(struct mt7996_dev *dev,
+				       const char *operation, int err)
+{
+	dev_err(dev->mt76.dev, "%s failed: %d; leaving device stopped\n",
+		operation, err);
+	dev->recovery.hw_full_reset = true;
+	ieee80211_stop_queues(mt76_hw(dev));
+	set_bit(MT76_RESET, &dev->mphy.state);
+	set_bit(MT76_MCU_RESET, &dev->mphy.state);
+	wake_up(&dev->mt76.mcu.wait);
+	mt76_worker_disable(&dev->mt76.tx_worker);
+	mt76_npu_disable_irqs(&dev->mt76);
+	mt7996_irq_disable(dev, ~0);
+	mt7996_dma_disable(dev, true);
+}
+
+static int mt7996_mac_full_reset(struct mt7996_dev *dev)
 {
 	struct ieee80211_hw *hw = mt76_hw(dev);
 	struct mt7996_phy *phy;
 	LIST_HEAD(list);
-	int i;
+	int i, err;
 
 	dev->recovery.hw_full_reset = true;
 
@@ -2342,7 +2357,19 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 	wake_up(&dev->mt76.mcu.wait);
 	ieee80211_stop_queues(hw);
 
-	cancel_work_sync(&dev->wed_rro.work);
+	mt7996_wed_rro_work_stop(dev);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed);
+
+	err = mt7996_npu_hw_stop(dev);
+	if (err) {
+		mt7996_npu_recovery_failed(dev,
+					   "NPU stop before full reset", err);
+		return err;
+	}
+
 	mt7996_for_each_phy(dev, phy)
 		cancel_delayed_work_sync(&phy->mt76->mac_work);
 
@@ -2350,12 +2377,14 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 
 	mutex_lock(&dev->mt76.mutex);
 	for (i = 0; i < 10; i++) {
-		if (!mt7996_mac_restart(dev))
+		err = mt7996_mac_restart(dev);
+		if (!err)
 			break;
 	}
-
-	if (i == 10)
-		dev_err(dev->mt76.dev, "chip full reset failed\n");
+	if (!err)
+		err = __mt7996_npu_hw_init(dev);
+	if (err)
+		goto fail_unlock;
 
 	mt7996_for_each_phy(dev, phy)
 		phy->omac_mask = 0;
@@ -2389,12 +2418,23 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 	dev->recovery.hw_full_reset = false;
 
 	mutex_unlock(&dev->mt76.mutex);
+	mt7996_wed_rro_work_start(dev);
 
 	ieee80211_wake_queues(mt76_hw(dev));
+	ieee80211_restart_hw(mt76_hw(dev));
 
-	ieee80211_wake_queues(mt76_hw(dev));
+	return 0;
 
-	ieee80211_restart_hw(mt76_hw(dev));
+fail_unlock:
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed);
+	mutex_unlock(&dev->mt76.mutex);
+	mt7996_npu_recovery_failed(dev,
+				   "full reset or NPU reinitialization", err);
+
+	return err;
 }
 
 void mt7996_mac_reset_work(struct work_struct *work)
@@ -2402,7 +2442,7 @@ void mt7996_mac_reset_work(struct work_struct *work)
 	struct ieee80211_hw *hw;
 	struct mt7996_dev *dev;
 	struct mt7996_phy *phy;
-	int i;
+	int i, err;
 
 	dev = container_of(work, struct mt7996_dev, reset_work);
 	hw = mt76_hw(dev);
@@ -2418,7 +2458,8 @@ void mt7996_mac_reset_work(struct work_struct *work)
 		else
 			dev->recovery.wm_reset_count++;
 
-		mt7996_mac_full_reset(dev);
+		if (mt7996_mac_full_reset(dev))
+			return;
 
 		/* enable mcu irq */
 		mt7996_irq_enable(dev, MT_INT_MCU_CMD);
@@ -2444,15 +2485,20 @@ void mt7996_mac_reset_work(struct work_struct *work)
 	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
 		mtk_wed_device_stop(&dev->mt76.mmio.wed);
 
-	mt7996_npu_hw_stop(dev);
 	ieee80211_stop_queues(mt76_hw(dev));
+	mt7996_wed_rro_work_stop(dev);
+	err = mt7996_npu_hw_stop(dev);
+	if (err) {
+		mt7996_npu_recovery_failed(dev,
+					   "NPU stop before L1 recovery", err);
+		return;
+	}
 
 	set_bit(MT76_RESET, &dev->mphy.state);
 	set_bit(MT76_MCU_RESET, &dev->mphy.state);
 	wake_up(&dev->mt76.mcu.wait);
 	mt76_abort_scan(&dev->mt76);
 
-	cancel_work_sync(&dev->wed_rro.work);
 	mt7996_for_each_phy(dev, phy) {
 		mt76_abort_roc(phy->mt76);
 		set_bit(MT76_RESET, &phy->mt76->state);
@@ -2516,7 +2562,9 @@ void mt7996_mac_reset_work(struct work_struct *work)
 				     MT_INT_TX_RX_DONE_EXT);
 	}
 
-	__mt7996_npu_hw_init(dev);
+	err = __mt7996_npu_hw_init(dev);
+	if (err)
+		goto fail_unlock;
 
 	clear_bit(MT76_MCU_RESET, &dev->mphy.state);
 	mt7996_for_each_phy(dev, phy)
@@ -2553,12 +2601,23 @@ void mt7996_mac_reset_work(struct work_struct *work)
 	mt7996_update_beacons(dev);
 
 	mutex_unlock(&dev->mt76.mutex);
+	mt7996_wed_rro_work_start(dev);
 
 	mt7996_for_each_phy(dev, phy)
 		ieee80211_queue_delayed_work(hw, &phy->mt76->mac_work,
 					     MT7996_WATCHDOG_TIME);
 	dev_info(dev->mt76.dev,"\n%s L1 SER recovery completed.",
 		 wiphy_name(dev->mt76.hw->wiphy));
+	return;
+
+fail_unlock:
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed);
+	mutex_unlock(&dev->mt76.mutex);
+	mt7996_npu_recovery_failed(dev,
+				   "NPU reinitialization after L1 recovery", err);
 }
 
 /* firmware coredump */
